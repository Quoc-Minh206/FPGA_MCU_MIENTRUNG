// =============================================================================
// File:        Project_FPGA_2026.cst
// Thiết bị:    GW1NSR-LV4CQN48PC6/I5 (Kit OneKiwi 4K / Tang Nano 4K)
// Mô tả:       Ràng buộc chân vật lý cho hệ thống tích hợp IMU MPU6050 + MicroSD + UART:
//              - MPU6050: SCL Pin 39, SDA Pin 40
//              - MicroSD: CS Pin 46, SCK Pin 43, MOSI Pin 42, MISO Pin 41
//              - UART TX: Pin 31 (kết nối máy tính qua cổng micro-USB / USB-TTL)
//              - Reset: Pin 14 (Nút nhấn KEY1 onboard)
// =============================================================================

// 1. Xung nhịp thạch anh Onboard 27 MHz (Bank 1 - 3.3V)
IO_LOC "sys_clkin" 45;
IO_PORT "sys_clkin" IO_TYPE=LVCMOS33 PULL_MODE=UP;

// Nút nhấn Reset phần cứng KEY1 (Bank 3 - 1.8V)
IO_LOC "ext_rst_n" 14;
IO_PORT "ext_rst_n" IO_TYPE=LVCMOS18 PULL_MODE=UP;

// 2. Giao tiếp I2C Master với cảm biến MPU6050 GY-521 (Bank 1 - 3.3V)
//    OPEN_DRAIN=ON: Bắt buộc để I2C hoạt động đúng (chỉ kéo LOW, không đẩy HIGH)
//    PULL_MODE=UP: Trở kéo nội bộ FPGA hỗ trợ pull-up (kết hợp với 10k trên module GY-521)
IO_LOC "i2c_scl" 39;
IO_PORT "i2c_scl" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_LOC "i2c_sda" 40;
IO_PORT "i2c_sda" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;

// 3. Kênh UART TX gửi dữ liệu lên Laptop / PC:
//    - Pin 31 (2-31, Bank 2 - 2.5V, sát góc HDMI)
//    - Pin 44 (3-44, Bank 1 - 3.3V, chuẩn điện áp 3.3V cho mạch CP2102)
//    - Pin 27, Pin 28 (2-27, 2-28, Bank 2 - 2.5V)
IO_LOC "uart_tx_pin" 31;
IO_PORT "uart_tx_pin" IO_TYPE=LVCMOS25 DRIVE=8;
IO_LOC "uart_tx_p44" 44;
IO_PORT "uart_tx_p44" IO_TYPE=LVCMOS33 DRIVE=8;
IO_LOC "uart_tx_p27" 27;
IO_PORT "uart_tx_p27" IO_TYPE=LVCMOS25 DRIVE=8;
IO_LOC "uart_tx_p28" 28;
IO_PORT "uart_tx_p28" IO_TYPE=LVCMOS25 DRIVE=8;

// 4. Giao tiếp SPI với MicroSD Card Adapter (Bank 1 - 3.3V)
IO_LOC "sd_cs" 46;
IO_PORT "sd_cs" IO_TYPE=LVCMOS33 DRIVE=8;
IO_LOC "sd_sck" 43;
IO_PORT "sd_sck" IO_TYPE=LVCMOS33 DRIVE=8;
IO_LOC "sd_mosi" 42;
IO_PORT "sd_mosi" IO_TYPE=LVCMOS33 DRIVE=8;
IO_LOC "sd_miso" 41;
IO_PORT "sd_miso" IO_TYPE=LVCMOS33 PULL_MODE=UP;

// 5. Đèn LED chỉ thị trạng thái hệ thống:
// LED Onboard bề mặt kit Kiwi 4K:
// - LED1 (Pin 10 / 3-10): Bank 0 (3.3V)
// - LED2 (Pin 13 / 1-13): Bank 3 (1.8V)
IO_LOC "led_onboard_1" 10;
IO_PORT "led_onboard_1" IO_TYPE=LVCMOS33 DRIVE=8;
IO_LOC "led_onboard_2" 13;
IO_PORT "led_onboard_2" IO_TYPE=LVCMOS18 DRIVE=8;

// LED mở rộng ra hàng chân cắm Header
IO_LOC "led_heartbeat" 32;
IO_PORT "led_heartbeat" IO_TYPE=LVCMOS25 DRIVE=8;
IO_LOC "led_imu_ok" 23;
IO_PORT "led_imu_ok" IO_TYPE=LVCMOS18 DRIVE=8;
IO_LOC "led_rec_active" 18;
IO_PORT "led_rec_active" IO_TYPE=LVCMOS18 DRIVE=8;
